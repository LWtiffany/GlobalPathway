# 复制为 .env 并填入真实密码（.env 已被 .gitignore 忽略，不会进仓库）。
# 注意：这是 prod（ECS 部署）用的模板 —— ADMIN_DB_HOST / ADMIN_DB_PORT 必须显式指向
# 阿里云 RDS 内网地址，用来覆盖 config.py 里默认的本地隧道值（127.0.0.1:15432）。
# 本地 dev 开发请勿依赖此文件，直接 `python -m admin_console serve`（默认已走 SSH 隧道）。
ADMIN_DB_HOST=pgm-2ze9t2uh39o1115k.rwlb.rds.aliyuncs.com
ADMIN_DB_PORT=5432
ADMIN_DB_NAME=team03
ADMIN_DB_USER=team03
ADMIN_DB_PASSWORD=CHANGE_ME
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765

# 用户端独立监听 8787；SQLite 用户数据保存在 Docker volume 中。
AGENT2_HOST=127.0.0.1
AGENT2_PORT=8787
AGENT2_DB_PATH=/var/lib/globalpathway/agent2.sqlite3
AGENT2_DEMO=1

# 用户端只读 Agent1 已发布知识所需的 RDS 连接。建议使用只读数据库账号。
AGENT1_ENV=production
AGENT1_DB_HOST=pgm-2ze9t2uh39o1115k.rwlb.rds.aliyuncs.com
AGENT1_DB_PORT=5432
AGENT1_DB_NAME=team03
AGENT1_DB_USER=team03
AGENT1_DB_PASSWORD=CHANGE_ME

# Agent2 LLM through Alibaba Model Studio's OpenAI-compatible endpoint.
# auto enables only when AGENT2_LLM_API_KEY exists. Use 0 to force deterministic mode.
AGENT2_LLM_ENABLED=auto
AGENT2_LLM_MODEL=qwen-plus
AGENT2_LLM_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENT2_LLM_STRUCTURED_MODE=json_schema
AGENT2_LLM_EXTRA_BODY={"enable_thinking":false}
AGENT2_LLM_TIMEOUT_SECONDS=60
AGENT2_LLM_MAX_RETRIES=1
AGENT2_LLM_API_KEY=
